# ---- OpenLDAP ----
LDAP_ORGANISATION=Meine Firma
LDAP_DOMAIN=deskforge.local
LDAP_BASE_DN=dc=deskforge,dc=local
LDAP_ADMIN_PASSWORD=bitte-ändern

# ---- PostgreSQL (für Authentik) ----
PG_PASS=bitte-ändern-langes-zufallspasswort

# ---- Authentik ----
# Erzeugen mit: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=bitte-ändern-langes-zufallssecret
# Aktuelles Image/Tag vor dem Deploy gegen https://docs.goauthentik.io prüfen
AUTHENTIK_TAG=2026.5

# Pfad zum ca.crt aus dem ca/-Verzeichnis, wird read-only in die Container
# gemountet, damit Authentik der internen CA vertrauen kann.
CA_CERT_PATH=../ca/ca-output/ca.crt

# ---- Samba (FSLogix-Profil-Share, siehe docs/FSLOGIX-PROFILE-CONTAINERS.md) ----
SAMBA_FSLOGIX_SERVICE_PASSWORD=bitte-ändern
