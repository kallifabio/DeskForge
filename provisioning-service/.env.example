PORT=4000
LOG_LEVEL=info

# Gemeinsamer Schlüssel mit dem Dashboard (dort: PROVISIONING_API_KEY).
# Erzeugen mit: openssl rand -hex 32
PROVISIONING_API_KEY=bitte-ändern

# ---- Interne CA ----
# Pfad zum ca.crt, damit dieser Dienst Proxmox und Kasm über HTTPS
# vertraut (löst das "Docker-Container sieht Host-Trust-Store nicht"-
# Problem aus dem Video).
CA_CERT_PATH=/certs/ca.crt

# ---- Proxmox VE ----
PROXMOX_BASE_URL=https://proxmox.deskforge.local:8006/api2/json
PROXMOX_TOKEN_ID=deskforge-provisioner@pve!provisioning
PROXMOX_TOKEN_SECRET=bitte-ändern
PROXMOX_NODE=pve
PROXMOX_TEMPLATE_VMID=9000
# "full" (Standard, sicher) oder "linked" (schneller/platzsparender, nur
# wenn der Storage Linked Clones unterstützt - siehe docs/SETUP.md).
PROXMOX_CLONE_MODE=full

# ---- Kasm Workspaces ----
KASM_BASE_URL=https://kasm.deskforge.local
KASM_API_KEY=bitte-ändern
KASM_API_KEY_SECRET=bitte-ändern
KASM_ZONE_ID=bitte-per-get_zones-ermitteln
# Optional: ID des Kasm-Workspace/-Images, auf den der "Verbinden"-Button
# im Dashboard direkt verlinken soll (.../#/launch/<id>). Ohne Wert
# verweist der Link auf den Kasm-Staging-Screen.
# KASM_WORKSPACE_ID=
KASM_MAX_SIMULTANEOUS_SESSIONS=1
KASM_MAX_SIMULTANEOUS_USERS=1

# Pfad zum register-vm.ps1 auf der Windows-VM (muss im Template bereits
# vorhanden sein, siehe windows-agent/GOLDEN-IMAGE-CHECKLIST.md).
WINDOWS_AGENT_SCRIPT_PATH=C:\\ProvisionAgent\\register-vm.ps1

# ---- VM-Pool ----
# Anzahl bereits gestarteter, aber noch nicht zugewiesener VMs, die
# ständig vorgehalten werden (schnellere Zuweisung, kostet aber laufend
# Ressourcen). 0 deaktiviert den Pool (jede Anfrage klont live).
POOL_SIZE=1
POOL_CHECK_INTERVAL_MS=60000

# ---- Idle-Timeout ----
# Nach wie vielen Minuten ohne aktive Kasm-Sitzung eine zugewiesene VM
# automatisch abgebaut wird.
IDLE_TIMEOUT_MINUTES=60
IDLE_CHECK_INTERVAL_MS=300000

# ---- Zustand ----
STATE_FILE_PATH=./data/state.json

# ---- Zugriff / Templates / Kontingente ----
# Optionale Datei (siehe access.example.json). Fehlt sie, gibt es genau
# ein Template "standard" (= PROXMOX_TEMPLATE_VMID).
ACCESS_FILE_PATH=./access.json
# Kontingent (gleichzeitige VMs pro Nutzer), wenn access.json fehlt oder
# keine passende Gruppenregel greift.
DEFAULT_MAX_CONCURRENT=1

# ---- Kosten-/Nutzungsansicht ----
# Stundensatz je laufender VM für die grobe Kostenschätzung im Dashboard.
# 0 = keine Kostenspalte.
COST_PER_VM_HOUR=0
COST_CURRENCY=EUR

# ---- Geplante Anforderungen ----
# Wie oft der Scheduler fällige Einträge (schedules[]) abarbeitet.
SCHEDULE_CHECK_INTERVAL_MS=60000
