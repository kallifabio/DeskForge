{
  "name": "deskforge-dashboard",
  "version": "2.0.0",
  "description": "Verwaltungs-Dashboard für VDI-Sitzungen: Selbstbedienungs-Ansicht für Nutzer, Admin-Übersicht über Nutzer/Sitzungen/VMs. Anmeldung per Authentik-SSO (OIDC).",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./src/public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./src/public/tailwind.css --watch",
    "sync:fontawesome": "node scripts/sync-fontawesome.js",
    "sync:sweetalert2": "node scripts/sync-sweetalert2.js",
    "prestart": "npm run build:css",
    "start": "node src/server.js",
    "dev": "node dev-server.js",
    "test": "node --test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "connect-redis": "^9.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "ldapts": "^9.0.0",
    "openid-client": "^5.7.1",
    "pino": "^9.5.0",
    "redis": "^6.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "sweetalert2": "^11.26.25",
    "tailwindcss": "^4.3.3"
  }
}
