# NODE_ENV=production aktiviert Secure-Cookies (nur über HTTPS) und die
# Warnung, falls kein Redis-Session-Store konfiguriert ist.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Mind. 16 Zeichen, langes Zufallssecret. Platzhalter mit "bitte ändern"
# werden von der Konfigurationsprüfung abgelehnt.
SESSION_SECRET=bitte-ändern-langes-zufallssecret-mind-16-zeichen

# Öffentliche Basis-URL des Dashboards. Wird für die CSRF-Ursprungsprüfung
# und den Post-Logout-Redirect genutzt. Ohne Wert wird der Ursprung aus
# dem Request abgeleitet (hinter Reverse-Proxy: trust proxy ist aktiv).
PUBLIC_URL=https://dashboard.deskforge.local

# Optionaler Redis-Session-Store. Ohne diesen Wert liegen die Sitzungen
# im Arbeitsspeicher - für Produktion/Mehr-Instanz-Betrieb unbedingt setzen.
# REDIS_URL=redis://redis:6379

CA_CERT_PATH=/certs/ca.crt

# ---- Authentik (OIDC-Provider für SSO) ----
# In Authentik: Applications -> Providers -> neuen OAuth2/OIDC-Provider
# anlegen, Redirect-URI auf http(s)://<dashboard-host>/auth/callback setzen,
# und den "groups"-Scope in den Provider-Scope-Mappings aktivieren (siehe
# docs/SETUP.md, Abschnitt 7.2) - sonst funktioniert die Admin-Erkennung
# unten nicht. Der Authorization-Code-Flow läuft mit PKCE (S256).
AUTHENTIK_ISSUER_URL=https://authentik.deskforge.local/application/o/deskforge-dashboard/
AUTHENTIK_CLIENT_ID=bitte-ändern
AUTHENTIK_CLIENT_SECRET=bitte-ändern
AUTHENTIK_REDIRECT_URI=http://localhost:5000/auth/callback
# Ziel nach dem Single-Logout gegen Authentik. Muss in Authentik als
# gültige Post-Logout-Redirect-URI hinterlegt sein. Ohne Wert wird
# PUBLIC_URL verwendet.
AUTHENTIK_POST_LOGOUT_REDIRECT_URI=https://dashboard.deskforge.local
# Name der Authentik-Gruppe, deren Mitglieder Admin-Rechte im Dashboard
# bekommen (alle Nutzer/Sitzungen/VMs sehen, für andere provisionieren).
AUTHENTIK_ADMIN_GROUP=deskforge-admins

# ---- OpenLDAP (Nutzerliste, nur lesend, nur für Admin-Ansicht) ----
LDAP_URL=ldap://openldap:389
LDAP_BIND_DN=cn=admin,dc=deskforge,dc=local
LDAP_BIND_PASSWORD=bitte-ändern
LDAP_BASE_DN=dc=deskforge,dc=local

# ---- Provisioning-Service ----
# Das Dashboard braucht ab hier KEINE eigenen Proxmox-/Kasm-Zugangsdaten
# mehr - alles läuft über diesen einen, authentifizierten Kanal.
PROVISIONING_SERVICE_URL=http://provisioning-service:4000
# Muss exakt mit PROVISIONING_API_KEY in provisioning-service/.env
# übereinstimmen. Mind. 16 Zeichen.
PROVISIONING_API_KEY=bitte-ändern-mind-16-zeichen
